{
  "name": "meals",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate-if-configured.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --tsconfig tsconfig.json src/db/seed.ts",
    "check:import": "tsx --tsconfig tsconfig.json scripts/check-import.ts",
    "check:auth": "tsx --tsconfig tsconfig.json scripts/check-auth.ts",
    "smoke": "npm run check:import && npm run check:auth && tsx --tsconfig tsconfig.json scripts/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@better-auth/passkey": "~1.7.20",
    "@electric-sql/pglite": "^0.5.15",
    "@modelcontextprotocol/server": "^2.4.0",
    "better-auth": "~1.7.20",
    "drizzle-orm": "^0.45.4",
    "mcp-handler": "^2.3.0",
    "next": "16.4.5",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
