# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL unset for local development: the app runs an embedded
# Postgres (PGlite) and stores it in ./data/pglite.
# On Vercel, the Neon integration sets this (any Postgres works). Every build
# runs migrations against it, so Preview must have its own database, never
# the production one.
# Never point a local dev server at the production database: with no Google
# client configured locally, everyone is the dev owner, and the dev owner is
# whoever already owns that database (see "Accounts" below).
# DATABASE_URL=postgres://user:password@host:5432/meals

# --- AI ----------------------------------------------------------------------
# Needed for the "photo of a plate -> ingredients" feature, and lets "Start
# from a link" read recipe pages that publish no structured recipe data.
# ANTHROPIC_API_KEY=sk-ant-...

# Local testing only: lets /api/import fetch localhost and private addresses
# (for example a fixture server). Never set this on a deployment.
# IMPORT_ALLOW_PRIVATE_URLS=true

# --- Assistant access (MCP) --------------------------------------------------
# Shared secret that Claude / ChatGPT / Gemini must send as a Bearer token to
# talk to /api/mcp. If unset, the endpoint is open outside production (fine on
# localhost) and refuses every request in production.
# MCP_API_KEY=some-long-random-string

# --- Household settings ------------------------------------------------------
# Used to work out what "tonight" means for the family.
HOUSEHOLD_TIMEZONE=America/New_York

# --- Accounts (sign-in) -------------------------------------------------------
# Everyone has a personal account in one invite-only family and signs in with
# Google. Leave all of these unset for local development: outside production
# with no Google client, everyone is the built-in dev owner and nothing asks
# you to sign in.
# In production (NODE_ENV=production) the app fails closed: until
# BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are all set,
# every page and API route is refused and /sign-in says sign-in isn't set up.
#
# Signs session cookies. Required on any deployment, different for Production
# and Preview; generate one with
#   openssl rand -base64 32
# BETTER_AUTH_SECRET=
# The site's public address, used for sign-in redirects and shown on /family
# as the address to give invited people. Set it on Production.
# BETTER_AUTH_URL=https://meals.example.com
# Google sign-in: an OAuth client from Google Cloud. Both must be set.
# Sign-up is invite only: a Google account can create an account only for
# OWNER_EMAIL (while there is no owner yet) or an email with a pending
# invitation, and only when Google has verified that email.
# Accounts are never linked automatically: if a member's Google account is
# deleted and re-created, sign-in is refused until the owner removes and
# re-invites them.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# The email of the Google account that becomes the family's owner on its
# first sign-in. Only needed until then: once an owner exists it grants
# nothing, so changing it can never create a second owner. Unset in
# production, nobody can become the owner, but invitations keep working.
# OWNER_EMAIL=you@example.com

# Google sign-in on Vercel PREVIEW deployments only (optional). Production
# and previews are fully separate: production has its own Google OAuth
# client (redirect URI on the production domain), its own BETTER_AUTH_SECRET,
# and none of the OAUTH_PROXY_* variables. Production ignores them even if
# set, and never runs the proxy. Nothing is shared with Preview.
# "Production" here means VERCEL_ENV=production. A production hosted
# anywhere but Vercel has no VERCEL_ENV, so it must never set OAUTH_PROXY_*:
# it would take part in the proxy as if it were a preview.
#
# Previews use a second Google OAuth client. Google only sends people back to
# registered addresses and every preview has a new one, so previews send
# Google sign-in through one fixed preview, which hands it back to the
# preview it started on. The fixed preview is the `epic/accounts` branch
# preview until the epic merges. After that it is a long-lived branch such as
# `auth-proxy`, which tracks main and must be kept up to date.
# Set these on the Preview environment, so on the fixed preview and every
# other preview. Leave them unset locally.
# OAUTH_PROXY_URL is the fixed preview's own branch address, exactly as
# Vercel reports it: that preview recognises itself by its VERCEL_BRANCH_URL.
# The preview Google client's only authorised redirect URI is
#   <OAUTH_PROXY_URL>/api/auth/callback/google
# OAUTH_PROXY_SECRET seals the hand-back. It is required with OAUTH_PROXY_URL
# and must differ from BETTER_AUTH_SECRET; otherwise the proxy stays off.
# Anyone holding it can forge a hand-back to a preview, so the fixed preview
# refuses hand-backs sent to it. Generate one with
#   openssl rand -base64 32
# A preview trusts only its own addresses for the return trip:
# BETTER_AUTH_URL, OAUTH_PROXY_URL, and its own VERCEL_URL and
# VERCEL_BRANCH_URL (set by Vercel). Never all of *.vercel.app.
# OAUTH_PROXY_URL=https://meals-git-epic-accounts-example.vercel.app
# OAUTH_PROXY_SECRET=
# On the fixed preview: the only preview addresses it may hand a sign-in back
# to. One pattern, https only, with a single `*` inside the first part of the
# host and fixed text on both sides of it (for example
# https://meals-*-myteam.vercel.app). Patterns such as https://*.vercel.app
# are refused. Unset, the fixed preview hands back to nothing but itself, so
# preview sign-in is refused.
# Known residual: the pattern could also match a preview in another Vercel
# scope whose slug ends the same way (meals-*-myteam would match
# meals-x-evil-myteam). Exploiting that still needs the Preview
# OAUTH_PROXY_SECRET, and exposes at most a preview user's basic Google
# profile, never a production sign-in.
# OAUTH_PROXY_PREVIEW_PATTERN=https://meals-*-myteam.vercel.app
