# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL unset for local development: the app runs an embedded
# Postgres (PGlite) and stores it in ./data/pglite.
# For a hosted deployment, point this at Postgres (e.g. a Supabase project).
# DATABASE_URL=postgres://user:password@host:5432/meals

# --- AI ----------------------------------------------------------------------
# Needed for the "photo of a plate -> ingredients" feature, and lets "Start
# from a link" read recipe pages that publish no structured recipe data.
# ANTHROPIC_API_KEY=sk-ant-...

# Local testing only: lets /api/import fetch localhost and private addresses
# (for example a fixture server). Never set this on a deployment.
# IMPORT_ALLOW_PRIVATE_URLS=true

# --- Assistant access (MCP) --------------------------------------------------
# Shared secret that Claude / ChatGPT / Gemini must send as a Bearer token to
# talk to /api/mcp. If unset, the endpoint is open (fine on localhost only).
# MCP_API_KEY=some-long-random-string

# --- Household settings ------------------------------------------------------
# Used to work out what "tonight" means for the family.
HOUSEHOLD_TIMEZONE=America/New_York

# One shared passcode the family types once per phone to use the web app.
# If unset, the app is open (fine on localhost). Set it on any deployment.
# Four or more random lowercase words joined by hyphens: easy to type on a
# phone, hard to guess. Guessing is slowed down but not blocked outright.
# HOUSEHOLD_PASSCODE=word-word-word-word

# --- Accounts (sign-in) -------------------------------------------------------
# Personal accounts are being added (see .claude/prds/accounts.md). Leave all
# of these unset for local development.
# Signs session cookies. Required on any deployment; generate one with
#   openssl rand -base64 32
# BETTER_AUTH_SECRET=
# The site's public address, used for sign-in redirects.
# BETTER_AUTH_URL=https://meals.example.com
# Google sign-in: an OAuth client from Google Cloud. Both must be set.
# Sign-up is invite only: a Google account can create an account only for
# OWNER_EMAIL (while there is no owner yet) or an email with a pending
# invitation, and only when Google has verified that email.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Google sign-in on Vercel preview deployments (optional). Google only sends
# people back to addresses registered on the OAuth client, and every preview
# has a new address, so previews send Google sign-in through one fixed
# deployment instead, which hands it back to the preview. Set the same two
# values on that deployment and on every preview. Leave both unset locally and
# wherever Google redirects straight back to the deployment.
# OAUTH_PROXY_URL is the fixed deployment's own address (until the accounts
# epic is on main, the stable `epic/accounts` branch preview). Register
#   <OAUTH_PROXY_URL>/api/auth/callback/google
# as an authorised redirect URI on the Google OAuth client.
# OAUTH_PROXY_SECRET seals the hand-back. Required with OAUTH_PROXY_URL, and it
# must differ from BETTER_AUTH_SECRET; otherwise the proxy stays off. Anyone
# holding it can forge a hand-back, so only previews accept one: the fixed
# deployment (whose VERCEL_BRANCH_URL is OAUTH_PROXY_URL) and any production
# deployment refuse them. Generate one with
#   openssl rand -base64 32
# Only this project's own addresses are trusted for the return trip:
# BETTER_AUTH_URL, OAUTH_PROXY_URL, and on a Vercel preview that preview's own
# VERCEL_URL and VERCEL_BRANCH_URL (set by Vercel). Never all of *.vercel.app.
# OAUTH_PROXY_URL=https://meals-git-epic-accounts-example.vercel.app
# OAUTH_PROXY_SECRET=
